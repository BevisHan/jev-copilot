_fixture.html
_e2e.ps1
_bench.ps1
_draft-bench.ps1
_draft-case.json
_action-bench.ps1
_action-cases.json

# Their outputs.
_*.log
_*-result.json
_draft-bench.json
_draft-quality.txt
_summary.txt
